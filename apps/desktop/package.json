{
  "name": "@rx/desktop",
  "version": "0.11.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "rx — a local-first Apple Messages client for macOS",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "pnpm build:contacts && electron-vite dev",
    "build": "electron-vite build",
    "build:contacts": "mkdir -p build && swiftc -O resources/contacts/rx-contacts.swift -o build/rx-contacts && codesign --force --sign - build/rx-contacts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "pretest": "pnpm --filter @rx/apple-body-decoder build:wasm",
    "test": "vitest run",
    "package": "pnpm build:contacts && electron-vite build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@rx/apple-body-decoder": "workspace:*",
    "@rx/apple-contacts": "workspace:*",
    "@rx/contract": "workspace:*",
    "@rx/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
